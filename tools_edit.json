 {
  "type": "function",
  "function": {
   "name": "remember",
   "description": "Save one short fact to long-term memory, ONLY when the user clearly asks you to remember something (e.g. a customer nickname, a shop rule, a preference). Never use it for anything else.",
   "parameters": {
    "type": "object",
    "properties": {
     "note": {
      "type": "string",
      "description": "the fact, short, max 150 characters"
     }
    },
    "required": [
     "note"
    ]
   }
  }
 },
 {
  "type": "function",
  "function": {
   "name": "forget",
   "description": "Remove a remembered note, ONLY when the user asks you to forget it. Give a few words of the note.",
   "parameters": {
    "type": "object",
    "properties": {
     "note": {
      "type": "string",
      "description": "words from the note to forget"
     }
    },
    "required": [
     "note"
    ]
   }
  }
 },
 {
  "type": "function",
  "function": {
   "name": "add_customer",
