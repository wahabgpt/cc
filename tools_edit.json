 {
  "type": "function",
  "function": {
   "name": "list_customers",
   "description": "List customers with balance. Use filter and sort to answer questions like \"who owes the most\".",
   "parameters": {
    "type": "object",
    "properties": {
     "filter": {
      "type": "string",
      "enum": [
       "all",
       "owing",
       "defaulters",
       "cleared"
      ],
      "description": "which customers"
     },
     "sort": {
      "type": "string",
      "enum": [
       "balance_desc",
       "balance_asc",
       "name",
       "recent"
      ],
      "description": "sort order"
     },
     "limit": {
      "type": "number",
      "description": "max rows, default 10"
     }
    },
    "required": []
   }
  }
 },
 {
  "type": "function",
  "function": {
   "name": "get_customer",
   "description": "Full details of one customer: balance and recent entries (sales and payments).",
   "parameters": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string",
      "description": "customer name"
     }
    },
    "required": [
     "name"
    ]
   }
  }
 },
 {
  "type": "function",
  "function": {
   "name": "get_sales_report",
   "description": "Sales (udhaar given) and payments received for a period. Use for questions like today sales, this week, this month, best selling items, top buyers.",
   "parameters": {
    "type": "object",
    "properties": {
     "period": {
      "type": "string",
      "enum": [
       "today",
       "week",
       "month",
       "all"
      ],
      "description": "time range, default week"
     }
    },
    "required": []
   }
  }
 },
 {
  "type": "function",
  "function": {
   "name": "list_stock",
   "description": "List stock products with quantity, cost and sell rate. Use filter low for items to restock, dead for items not sold for 30+ days.",
   "parameters": {
    "type": "object",
    "properties": {
     "filter": {
      "type": "string",
      "enum": [
       "all",
       "low",
       "dead"
      ],
      "description": "which products"
     },
     "limit": {
      "type": "number",
      "description": "max rows, default 15"
     }
    },
    "required": []
   }
  }
 },
